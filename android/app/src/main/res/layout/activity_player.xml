<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/native_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/player_danmaku_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <FrameLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="top"
            android:background="@drawable/player_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageButton
                android:id="@+id/player_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/player_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="#F7F5F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_quality"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/player_toolbar_button_background"
                android:gravity="center"
                android:minWidth="78dp"
                android:paddingHorizontal="14dp"
                android:text="@string/player_quality_original"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_debug_toggle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/player_toolbar_button_background"
                android:gravity="center"
                android:minWidth="68dp"
                android:paddingHorizontal="13dp"
                android:text="@string/player_debug"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_danmaku"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/player_toolbar_button_background"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingHorizontal="13dp"
                android:text="@string/player_danmaku_on"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/player_toolbar_button_background"
                android:gravity="center"
                android:minWidth="78dp"
                android:paddingHorizontal="14dp"
                android:text="@string/player_subtitles"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_danmaku_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="78dp"
            android:background="@drawable/player_mode_badge_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="420dp"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:textColor="#F7F5F0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="15dp">

            <SeekBar
                android:id="@+id/player_seek"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressTint="#8C83FF"
                android:thumbTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_play_pause"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="00:00 / 00:00"
                    android:textColor="#F7F5F0"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/player_mode_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/player_mode_badge_background"
                    android:gravity="center"
                    android:paddingHorizontal="11dp"
                    android:text="@string/player_compatibility_badge"
                    android:textColor="#D5D2DC"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/player_debug_panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="82dp"
        android:background="@drawable/player_debug_panel_background"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/player_debug_title"
                android:textColor="#F7F5F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_debug_live"
                android:textColor="#B8FF72"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_debug_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="@string/player_debug_waiting"
            android:textColor="#D5D2DC"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_error_background"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:id="@+id/player_panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_settings_panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/player_panel_background"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_panel_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/player_subtitle_settings"
                android:textColor="#F7F5F0"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_panel_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/player_close"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/player_subtitle_settings_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:text="@string/player_subtitle_settings_hint"
                        android:textColor="#A9A7B0"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_danmaku_display" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/player_danmaku_settings_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:paddingEnd="12dp"
                            android:text="@string/player_danmaku_not_loaded"
                            android:textColor="#B8B6C0"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/player_danmaku_settings_toggle"
                            android:layout_width="76dp"
                            android:layout_height="38dp"
                            android:background="@drawable/player_setting_option"
                            android:gravity="center"
                            android:text="@string/player_enabled"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/player_danmaku_type_filter" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <TextView
                            android:id="@+id/player_danmaku_scrolling_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_scrolling" />

                        <TextView
                            android:id="@+id/player_danmaku_top_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_top" />

                        <TextView
                            android:id="@+id/player_danmaku_bottom_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_bottom" />

                        <TextView
                            android:id="@+id/player_danmaku_color_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_color" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/player_danmaku_scale_with_screen_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_scale_with_screen" />

                        <TextView
                            android:id="@+id/player_danmaku_protect_subtitles_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_protect_subtitles" />

                        <TextView
                            android:id="@+id/player_danmaku_smart_collision_toggle"
                            style="@style/PlayerSettingTinyOption"
                            android:text="@string/player_danmaku_smart_collision" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/player_danmaku_area"
                            android:textColor="#A9A7B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_danmaku_area_value"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="70%"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/player_danmaku_area_seek"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:max="9"
                        android:progress="6"
                        android:progressTint="#8C83FF"
                        android:thumbTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/player_danmaku_opacity"
                            android:textColor="#A9A7B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_danmaku_opacity_value"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/player_danmaku_opacity_seek"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:max="9"
                        android:progress="9"
                        android:progressTint="#8C83FF"
                        android:thumbTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/player_danmaku_size"
                            android:textColor="#A9A7B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_danmaku_size_value"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/player_danmaku_size_seek"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:max="10"
                        android:progress="5"
                        android:progressTint="#8C83FF"
                        android:thumbTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/player_danmaku_speed"
                            android:textColor="#A9A7B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_danmaku_speed_value"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/player_danmaku_speed_normal"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/player_danmaku_speed_seek"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:max="4"
                        android:progress="2"
                        android:progressTint="#8C83FF"
                        android:thumbTint="#FFFFFF" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="2dp"
                        android:background="#292932" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/player_subtitle_display"
                            android:textColor="#F7F5F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_subtitle_toggle"
                            android:layout_width="76dp"
                            android:layout_height="38dp"
                            android:background="@drawable/player_setting_option"
                            android:gravity="center"
                            android:text="@string/player_enabled"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                        android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_track" />

                    <TextView
                        android:id="@+id/player_subtitle_track_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/player_subtitle_track_waiting"
                        android:textColor="#A9A7B0"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/player_subtitle_track_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_style" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/subtitle_style_original"
                            style="@style/PlayerSettingOption"
                            android:layout_marginEnd="5dp"
                            android:text="@string/player_subtitle_style_original" />

                        <TextView
                            android:id="@+id/subtitle_style_outline"
                            style="@style/PlayerSettingOption"
                            android:layout_marginStart="5dp"
                            android:text="@string/player_subtitle_style_outline" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/subtitle_style_yellow"
                            style="@style/PlayerSettingOption"
                            android:layout_marginEnd="5dp"
                            android:text="@string/player_subtitle_style_yellow" />

                        <TextView
                            android:id="@+id/subtitle_style_box"
                            style="@style/PlayerSettingOption"
                            android:layout_marginStart="5dp"
                            android:text="@string/player_subtitle_style_box" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_size" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/player_subtitle_size_seek"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:max="8"
                            android:progress="4"
                            android:progressTint="#8C83FF"
                            android:thumbTint="#FFFFFF" />

                        <TextView
                            android:id="@+id/player_subtitle_size_value"
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="30 sp"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_position" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/player_subtitle_position_seek"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:max="8"
                            android:progress="3"
                            android:progressTint="#8C83FF"
                            android:thumbTint="#FFFFFF" />

                        <TextView
                            android:id="@+id/player_subtitle_position_value"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="距底部 9%"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView android:id="@+id/subtitle_color_white" style="@style/PlayerSettingCompactOption" android:text="@string/player_color_white" />
                        <TextView android:id="@+id/subtitle_color_yellow" style="@style/PlayerSettingCompactOption" android:text="@string/player_color_yellow" />
                        <TextView android:id="@+id/subtitle_color_cyan" style="@style/PlayerSettingCompactOption" android:text="@string/player_color_cyan" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/player_subtitle_outline_seek"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:max="6"
                            android:progress="3"
                            android:progressTint="#8C83FF"
                            android:thumbTint="#FFFFFF" />

                        <TextView
                            android:id="@+id/player_subtitle_outline_value"
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="3 px"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/PlayerSettingLabel"
                        android:text="@string/player_subtitle_background" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/player_subtitle_background_seek"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:max="10"
                            android:progress="0"
                            android:progressTint="#8C83FF"
                            android:thumbTint="#FFFFFF" />

                        <TextView
                            android:id="@+id/player_subtitle_background_value"
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%"
                            android:textColor="#F7F5F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/player_subtitle_compatibility_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/player_subtitle_compatibility_note"
                        android:textColor="#777984"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/player_quality_settings_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/player_quality_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="@string/player_quality_original_hint"
                        android:textColor="#A9A7B0"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <LinearLayout
                        android:id="@+id/player_quality_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/player_quality_transcode_note"
                        android:textColor="#777984"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
